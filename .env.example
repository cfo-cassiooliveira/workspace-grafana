# Nomes das variáveis do .env (sem valores). O .env real é gerado por ./scripts/generate-env.sh e NUNCA é versionado.
# Conta local de recuperação (break-glass), usada só se o Keycloak estiver fora do ar.
GRAFANA_ADMIN_USER=
GRAFANA_ADMIN_PASSWORD=
# Chave de assinatura/cifra de segredos do Grafana.
GF_SECURITY_SECRET_KEY=
# Segredo do client "grafana" do Keycloak (copiado de ../keycloak/.env pelo generate-env.sh).
KC_GRAFANA_CLIENT_SECRET=
