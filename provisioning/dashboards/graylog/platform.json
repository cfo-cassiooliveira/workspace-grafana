            {
              "type": "count",
              "id": "1"
            }
          ],
          "bucketAggs": [
            {
              "type": "terms",
              "id": "2",
              "field": "service_name",
              "settings": {
                "size": "20",
                "order": "desc",
                "orderBy": "_count",
                "min_doc_count": "1"
              }
            }
          ]
        }
      ],
      "transformations": [
        {
          "id": "joinByField",
          "options": {
            "byField": "service_name",
            "mode": "outer"
          }
        },
        {
          "id": "calculateField",
          "options": {
            "mode": "reduceRow",
            "reduce": {
              "reducer": "sum",
              "include": [
                "Count 2"
              ]
            },
            "nullValueMode": "zero",
            "alias": "Erros",
            "replaceFields": false
          }
        },
        {
          "id": "calculateField",
          "options": {
            "mode": "binary",
            "binary": {
              "left": {
                "matcher": {
                  "id": "byName",
                  "options": "Erros"
                }
              },
              "operator": "/",
              "right": {
                "matcher": {
                  "id": "byName",
                  "options": "Count 1"
                }
              }
            },
            "alias": "Taxa de erro",
            "replaceFields": false
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Count 2": true
            },
            "indexByName": {
              "service_name": 0,
              "Taxa de erro": 1,
              "Erros": 2,
              "Count 1": 3
            },
            "renameByName": {
              "service_name": "Serviço",
              "Count 1": "Logs"
            }
          }
        }
      ],
      "options": {
        "showHeader": true,
        "sortBy": [
