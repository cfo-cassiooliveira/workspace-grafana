{
  "uid": "rabbitmq-log-shipper",
  "title": "RabbitMQ - Coletor de logs",
  "description": "Fluent Bit que leva o log do broker ao Graylog (GELF TCP): se está no ar, backlog em disco, retentativas, erros e descartes da saída gelf.0. Fonte: job rabbitmq-log-shipper do Prometheus (ADR-0005).",
  "tags": [
    "rabbitmq",
    "prometheus",
    "logs"
  ],
  "editable": false,
  "schemaVersion": 42,
  "graphTooltip": 1,
  "refresh": "1m",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timezone": "browser",
  "templating": {
    "list": []
  },
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Anotações",
        "type": "dashboard"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "type": "stat",
      "title": "Coletor no ar",
      "description": "UP = o Prometheus coletou as métricas do Fluent Bit (log-shipper:2020) no último scrape; DOWN = coletor parado, broker fora ou Prometheus sem o override docker-compose.rabbitmq.yml.",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max(up{job=\"rabbitmq-log-shipper\"})",
          "instant": true,
          "range": false
        }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "noValue": "Sem dados",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DOWN",
                  "color": "red"
                },
                "1": {
                  "text": "UP",
                  "color": "green"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "type": "stat",
      "title": "Backlog em disco (chunks)",
      "description": "Chunks no buffer em disco esperando envio. Fica acima de 0 só por instantes em operação normal; parado acima de 0 = destino (Graylog) fora ou lento. Teto do buffer: 200 MB.",
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(fluentbit_storage_fs_chunks{job=\"rabbitmq-log-shipper\"})",
          "instant": true,
          "range": false
        }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "noValue": "Sem dados",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "type": "stat",
      "title": "Retentativas que falharam (15 min)",
      "description": "Envios que esgotaram as retentativas na saída gelf.0 nos últimos 15 minutos.",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(increase(fluentbit_output_retries_failed_total{job=\"rabbitmq-log-shipper\"}[15m]))",
          "instant": true,
          "range": false
        }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "noValue": "Sem dados",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "type": "stat",
      "title": "Registros descartados (15 min)",
      "description": "Registros de log perdidos (teto do buffer em disco atingido) nos últimos 15 minutos. É a única forma de perda do coletor: qualquer valor acima de 0 é crítico.",
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(increase(fluentbit_output_dropped_records_total{job=\"rabbitmq-log-shipper\"}[15m]))",
          "instant": true,
          "range": false
        }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "noValue": "Sem dados",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "type": "timeseries",
      "title": "Registros por minuto",
      "description": "Registros lidos do log do broker (entrada) e entregues ao Graylog (saída gelf.0), por minuto.",
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(fluentbit_input_records_total{job=\"rabbitmq-log-shipper\",name=\"tail.0\"}[5m])) * 60",
          "legendFormat": "lidos"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(fluentbit_output_proc_records_total{job=\"rabbitmq-log-shipper\"}[5m])) * 60",
          "legendFormat": "enviados"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "noValue": "Sem dados",
          "min": 0,
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "id": 6,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "type": "timeseries",
      "title": "Backlog em disco ao longo do tempo",
      "description": "Chunks no buffer em disco. Crescimento contínuo = o Graylog não está recebendo.",
      "gridPos": {
        "x": 12,
        "y": 5,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(fluentbit_storage_fs_chunks{job=\"rabbitmq-log-shipper\"})",
          "legendFormat": "chunks em disco"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "noValue": "Sem dados",
          "min": 0,
          "unit": "short",
          "decimals": 0
        },
        "overrides": []
      }
    },
    {
      "id": 7,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "type": "timeseries",
      "title": "Retentativas, erros e descartes da saída",
      "description": "Eventos da saída gelf.0 em janelas de 5 minutos: retentativas, retentativas esgotadas, erros e registros descartados.",
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(increase(fluentbit_output_retries_total{job=\"rabbitmq-log-shipper\"}[5m]))",
          "legendFormat": "retentativas"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(increase(fluentbit_output_retries_failed_total{job=\"rabbitmq-log-shipper\"}[5m]))",
          "legendFormat": "retentativas esgotadas"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(increase(fluentbit_output_errors_total{job=\"rabbitmq-log-shipper\"}[5m]))",
          "legendFormat": "erros"
        },
        {
          "refId": "D",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(increase(fluentbit_output_dropped_records_total{job=\"rabbitmq-log-shipper\"}[5m]))",
          "legendFormat": "descartados"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "noValue": "Sem dados",
          "min": 0,
          "unit": "short",
          "decimals": 0
        },
        "overrides": []
      }
    }
  ]
}
