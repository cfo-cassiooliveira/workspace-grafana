{
  "uid": "keycloak-authentication",
  "title": "Keycloak - Autenticação",
  "description": "Logins com sucesso e falha, falhas em rajada e eventos por tipo, cliente e realm, a partir da auditoria do Keycloak no Graylog. Somente agregações: sem usuário, e-mail, IP nem login mascarado. CAMPOS A CONFIRMAR contra logs reais: type, kind, client_id, realm_id (ver README).",
  "tags": [
    "keycloak",
    "autenticacao",
    "lgpd-agregado"
  ],
  "schemaVersion": 42,
  "editable": false,
  "graphTooltip": 1,
  "refresh": "1m",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "30s",
      "1m",
      "5m",
      "15m"
    ]
  },
  "templating": {
    "list": []
  },
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "name": "Annotations"
      }
    ]
  },
  "links": [
    {
      "title": "Abrir no Graylog (eventos do Keycloak)",
      "type": "link",
      "icon": "external link",
      "url": "http://localhost:9000/search?q=service_name%3Akeycloak&rangetype=relative&relative=21600",
      "targetBlank": true,
      "tooltip": "Drill-down: abre a busca do Graylog; o login no Graylog é separado e controla o acesso aos eventos brutos."
    }
  ],
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Logins com sucesso",
      "description": "Eventos LOGIN no período. Campo a confirmar: type=LOGIN.",
      "gridPos": {
        "h": 5,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "grafana-opensearch-datasource",
        "uid": "graylog-opensearch"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-opensearch-datasource",
            "uid": "graylog-opensearch"
          },
          "query": "service_name:keycloak AND kind:user AND type:LOGIN",
          "alias": "Sucesso",
          "timeField": "timestamp",
          "metrics": [
            {
              "id": "1",
              "type": "count"
            }
          ],
          "bucketAggs": [
            {
              "id": "2",
              "type": "date_histogram",
              "field": "timestamp",
              "settings": {
                "interval": "auto",
                "min_doc_count": "0"
              }
            }
          ]
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "Sem logins no período",
          "unit": "short",
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "green"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "sum"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "value",
        "justifyMode": "center"
      }
    },
