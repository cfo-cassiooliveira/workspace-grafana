    {
      "id": 4,
      "type": "timeseries",
      "title": "Falhas de login em rajada (janelas de 5 min)",
      "description": "LOGIN_ERROR por janela de 5 minutos. A linha tracejada em 20 é o limiar do alerta do Graylog (força bruta / credential stuffing).",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 5
      },
      "datasource": {
        "type": "grafana-opensearch-datasource",
