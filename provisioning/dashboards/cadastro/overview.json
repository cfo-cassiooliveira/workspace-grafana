    {
      "id": 6,
      "type": "timeseries",
      "title": "Taxa de erros (%)",
      "description": "Erros (level <= 3) divididos pelo total de eventos, por intervalo. Exclui os logs dos health checks (KeycloakHealthCheck e DefaultHealthCheckService) e do smoke, como o alerta Cadastro - Taxa de erros alta. Sem dados: nenhum log no período (a taxa não é calculada com total zero).",
      "gridPos": {
        "h": 10,
        "w": 12,
        "x": 12,
        "y": 4
      },
      "datasource": {
        "type": "grafana-opensearch-datasource",
        "uid": "graylog-opensearch"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-opensearch-datasource",
            "uid": "graylog-opensearch"
          },
          "queryType": "lucene",
          "metrics": [
            {
              "id": "1",
              "type": "count"
            }
          ],
          "timeField": "timestamp",
          "alias": "Total",
          "query": "service_name:cadastro-* AND NOT smoke_test:true AND NOT SourceContext:\"Cadastro.Infrastructure.Keycloak.KeycloakHealthCheck\" AND NOT SourceContext:\"Microsoft.Extensions.Diagnostics.HealthChecks.DefaultHealthCheckService\"",
          "bucketAggs": [
            {
              "id": "2",
              "type": "date_histogram",
              "field": "timestamp",
              "settings": {
                "interval": "auto",
                "min_doc_count": "0"
              }
            }
          ]
        },
        {
          "refId": "B",
          "datasource": {
            "type": "grafana-opensearch-datasource",
            "uid": "graylog-opensearch"
          },
          "queryType": "lucene",
          "metrics": [
            {
              "id": "1",
              "type": "count"
            }
          ],
          "timeField": "timestamp",
          "alias": "Erros",
          "query": "service_name:cadastro-* AND level:<=3 AND NOT smoke_test:true AND NOT SourceContext:\"Cadastro.Infrastructure.Keycloak.KeycloakHealthCheck\" AND NOT SourceContext:\"Microsoft.Extensions.Diagnostics.HealthChecks.DefaultHealthCheckService\"",
          "bucketAggs": [
            {
              "id": "2",
              "type": "date_histogram",
              "field": "timestamp",
              "settings": {
                "interval": "auto",
                "min_doc_count": "0"
              }
            }
          ]
        }
      ],
      "transformations": [
        {
          "id": "joinByField",
          "options": {
            "byField": "Time",
            "mode": "outer"
          }
        },
        {
          "id": "calculateField",
          "options": {
            "mode": "binary",
            "binary": {
              "left": {
                "matcher": {
                  "id": "byName",
                  "options": "Erros"
                }
              },
              "operator": "/",
              "right": {
                "matcher": {
                  "id": "byName",
                  "options": "Total"
                }
              }
            },
            "alias": "Taxa de erros",
            "replaceFields": true
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "noValue": "Sem dados no período selecionado",
          "color": {
            "mode": "fixed",
            "fixedColor": "red"
          },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
