        "type": "prometheus",
        "uid": "prometheus"
      },
      "type": "stat",
      "title": "Na DLQ",
      "description": "Mensagens prontas na dead-letter queue. Investigue no Graylog antes de reprocessar ou descartar.",
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "rabbitmq_queue_messages_ready{job=\"rabbitmq\",vhost=\"dev\",queue=\"cadastro.user-import-lines.dlq\"}",
          "instant": true,
          "range": false
