      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "type": "timeseries",
      "title": "Fila principal",
      "description": "Mensagens prontas e não confirmadas ao longo do tempo.",
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "rabbitmq_queue_messages_ready{job=\"rabbitmq\",vhost=\"dev\",queue=\"cadastro.user-import-lines\"}",
          "legendFormat": "Prontas",
          "range": true
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "rabbitmq_queue_messages_unacked{job=\"rabbitmq\",vhost=\"dev\",queue=\"cadastro.user-import-lines\"}",
          "legendFormat": "Não confirmadas",
          "range": true
