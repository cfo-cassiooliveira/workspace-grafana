      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "fieldConfig": {
        "defaults": {
          "noValue": "Sem dados",
          "unit": "short",
          "min": 0,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      }
    },
    {
      "id": 6,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "type": "timeseries",
      "title": "Taxa da fila principal",
      "description": "Mensagens por segundo publicadas pelo relay (retornos do retry não contam), entregues ao consumidor e confirmadas.",
      "gridPos": {
        "x": 12,
        "y": 5,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(rabbitmq_queue_exchange_messages_published_total{job=\"rabbitmq\",vhost=\"dev\",queue=\"cadastro.user-import-lines\"}[$__rate_interval]))",
          "legendFormat": "Publicadas",
          "range": true
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "rate(rabbitmq_queue_messages_delivered_ack_total{job=\"rabbitmq\",vhost=\"dev\",queue=\"cadastro.user-import-lines\"}[$__rate_interval])",
          "legendFormat": "Entregues",
          "range": true
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "rate(rabbitmq_queue_messages_acked_total{job=\"rabbitmq\",vhost=\"dev\",queue=\"cadastro.user-import-lines\"}[$__rate_interval])",
          "legendFormat": "Confirmadas",
          "range": true
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "fieldConfig": {
        "defaults": {
          "noValue": "Sem dados",
          "unit": "cps",
          "min": 0,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      }
    },
